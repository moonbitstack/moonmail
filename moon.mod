name = "moonbitstack/moonmail"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonmail"

license = "Apache-2.0"

keywords = [
  "email",
  "mail",
  "smtp",
  "imap",
  "pop3",
  "dkim",
  "mime",
  "moonbit",
]

description = "Email for MoonBit: the message model, MIME and DKIM, and SMTP, LMTP, IMAP and POP3."

source = "src"

import {
  "moonbitstack/moonbase@0.4.2",
  "moonbitstack/mooncrypt@0.4.4",
  "moonbitstack/moonmime@0.2.1",
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/moonucd@0.1.1",
  "moonbitstack/moonnet@0.1.4",
  "moonbitstack/moontls@0.9.3",
  "moonbitstack/mooncred@0.6.5",
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonfetch@0.1.0",
}
