// IMAP4rev2 client (RFC 9051) that also speaks to IMAP4rev1 servers
// (RFC 3501), as a state machine with no I/O: commands in, octets out,
// responses parsed by the grammar and reported. IDLE (RFC 2177), CONDSTORE
// (RFC 7162), literals (RFC 7888) and SASL-IR (RFC 4959).
// https://www.rfc-editor.org/rfc/rfc9051
// https://www.rfc-editor.org/rfc/rfc3501
// https://www.rfc-editor.org/rfc/rfc2177
// https://www.rfc-editor.org/rfc/rfc7162
// https://www.rfc-editor.org/rfc/rfc7888
import {
  "moonbitstack/moonbase/base64",
  "moonbitstack/moonmail/sasl",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
} for "wbtest"
