// POP3 client (RFC 1939) with the extension mechanism (RFC 2449), SASL
// (RFC 5034) and STLS (RFC 2595), as a state machine with no I/O.
// https://www.rfc-editor.org/rfc/rfc1939
// https://www.rfc-editor.org/rfc/rfc2449
// https://www.rfc-editor.org/rfc/rfc5034
// https://www.rfc-editor.org/rfc/rfc2595
import {
  "moonbitstack/moonbase/base64",
  "moonbitstack/mooncrypt/hash/md5",
  "moonbitstack/moonmail/sasl",
  "moonbitlang/core/encoding/utf8",
}
