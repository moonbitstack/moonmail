// A tour of moonmail, runnable: `moon run src/examples/tour`.
pkgtype(kind: "executable")

import {
  "moonbitstack/moonmail",
  "moonbitstack/moonmime",
  "moonbitstack/moonmime/qp",
  "moonbitstack/moonmail/pop3",
  "moonbitstack/moonmail/smtp",
  "moonbitstack/moonmail/imap",
  "moonbitstack/moonmail/dkim",
  "moonbitstack/mooncrypt/sign/ed25519",
  "moonbitstack/moonbase/base64",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}
