///|
test "email vectors: message plain" {
  let message = @moonmail.Message::parse(
    b"From: a@example.com\r\nSubject: =?utf-8?B?Q2Fmw6k=?=\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\nCaf=C3=A9 and cr=C3=A8me\r\n",
  )
  assert_eq(message.subject(), Some("Caf\u{e9}"))
  assert_eq(message.content_type().essence, "text/plain")
  assert_eq(message.text(), Some("Caf\u{e9} and cr\u{e8}me\r\n"))
  assert_eq(message.html(), None)
  assert_eq(message.attachments().map(a => a.name), [])
}

///|
test "email vectors: message alternative" {
  let message = @moonmail.Message::parse(
    b"From: a@example.com\r\nSubject: Two\r\nMIME-Version: 1.0\r\nContent-Type: multipart/alternative; boundary=\"b1\"\r\n\r\npreamble\r\n--b1\r\nContent-Type: text/plain; charset=us-ascii\r\n\r\nplain body\r\n--b1\r\nContent-Type: text/html; charset=utf-8\r\nContent-Transfer-Encoding: base64\r\n\r\nPHA+aHRtbCBib2R5PC9wPg==\r\n--b1--\r\nepilogue\r\n",
  )
  assert_eq(message.subject(), Some("Two"))
  assert_eq(message.content_type().essence, "multipart/alternative")
  assert_eq(message.text(), Some("plain body"))
  assert_eq(message.html(), Some("<p>html body</p>"))
  assert_eq(message.attachments().map(a => a.name), [])
}

///|
test "email vectors: message mixed" {
  let message = @moonmail.Message::parse(
    b"From: a@example.com\r\nSubject: Files\r\nMIME-Version: 1.0\r\nContent-Type: multipart/mixed; boundary=\"outer\"\r\n\r\n--outer\r\nContent-Type: multipart/related; boundary=\"inner\"\r\n\r\n--inner\r\nContent-Type: text/html; charset=utf-8\r\n\r\n<img src=\"cid:logo\">\r\n--inner\r\nContent-Type: image/png\r\nContent-ID: <logo>\r\nContent-Disposition: inline; filename=\"logo.png\"\r\nContent-Transfer-Encoding: base64\r\n\r\niVBORw0K\r\n--inner--\r\n--outer\r\nContent-Type: application/pdf; name=\"report.pdf\"\r\nContent-Disposition: attachment; filename*=utf-8''r%C3%A9sum%C3%A9.pdf\r\nContent-Transfer-Encoding: base64\r\n\r\nJVBERi0=\r\n--outer--\r\n",
  )
  assert_eq(message.subject(), Some("Files"))
  assert_eq(message.content_type().essence, "multipart/mixed")
  assert_eq(message.text(), None)
  assert_eq(message.html(), Some("<img src=\"cid:logo\">"))
  assert_eq(message.attachments().map(a => a.name), [
    "logo.png", "r\u{e9}sum\u{e9}.pdf",
  ])
}

///|
test "email vectors: message latin" {
  let message = @moonmail.Message::parse(
    b"From: a@example.com\r\nSubject: =?iso-8859-1?q?caf=E9?=\r\nContent-Type: text/plain; charset=iso-8859-1\r\nContent-Transfer-Encoding: 8bit\r\n\r\ncaf\xe9\n",
  )
  assert_eq(message.subject(), Some("caf\u{e9}"))
  assert_eq(message.content_type().essence, "text/plain")
  assert_eq(message.text(), Some("caf\u{e9}\n"))
  assert_eq(message.html(), None)
  assert_eq(message.attachments().map(a => a.name), [])
}

///|
test "email vectors: message embedded" {
  let message = @moonmail.Message::parse(
    b"From: a@example.com\r\nSubject: Fwd\r\nContent-Type: multipart/mixed; boundary=\"m\"\r\n\r\n--m\r\nContent-Type: text/plain\r\n\r\nsee below\r\n--m\r\nContent-Type: message/rfc822\r\n\r\nFrom: b@example.com\r\nSubject: Inner\r\n\r\ninner body\r\n--m--\r\n",
  )
  assert_eq(message.subject(), Some("Fwd"))
  assert_eq(message.content_type().essence, "multipart/mixed")
  assert_eq(message.text(), Some("see below"))
  assert_eq(message.html(), None)
  assert_eq(message.attachments().map(a => a.name), [""])
}
