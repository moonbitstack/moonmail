// JMAP over moonfetch: an async HTTP transport for @moonmail/jmap. Native only,
// because moonfetch's sockets are; the protocol model in @moonmail/jmap stays
// pure and is tested on every target.
// https://www.rfc-editor.org/rfc/rfc8620
import {
  "moonbitstack/moonmail/jmap",
  "moonbitstack/moonfetch",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+native"
