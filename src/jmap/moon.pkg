// JMAP (RFC 8620) and JMAP for Mail (RFC 8621): the JSON request and response
// model, kept free of HTTP so a caller supplies the transport and a test can
// replay a recorded exchange. The `@moonmail/jmap/fetch` adapter wires it to
// moonfetch.
// https://www.rfc-editor.org/rfc/rfc8620
// https://www.rfc-editor.org/rfc/rfc8621
import {
  "moonbitstack/moonjson",
  "moonbitlang/core/encoding/utf8",
}
